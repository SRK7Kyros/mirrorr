# ══════════════════════════════════════════════════════════════════════════════
# Mirrorr Configuration
# ══════════════════════════════════════════════════════════════════════════════
#
# Copy this file to .env and edit as needed:
#
#   cp .env.example .env
#
# Path format rules (platform-aware):
#   - Relative paths must start with "./" (e.g. ./content) — valid on all OS.
#   - On Windows: use drive-letter absolute paths (e.g. C:/data/mirrorr).
#   - On Unix/Linux/macOS: use root-absolute paths (e.g. /var/lib/mirrorr).
#   - Using the wrong absolute format for your platform causes a startup error.
#
# Boolean values: true / false


# ── Paths ──────────────────────────────────────────────────────────────────

# BASE_DIR — Root directory for all Mirrorr state.
# All other paths derive from this unless overridden.
# Default: . (current working directory)
BASE_DIR=.

# CONTENT_DIR — Session and video data storage.
# Default: <BASE_DIR>/content
CONTENT_DIR=./content

# AUTORUNS_DIR — Autorun session storage.
# Default: <CONTENT_DIR>/autoruns
AUTORUNS_DIR=./content/autoruns

# RECORDINGS_DIR — Recording session storage.
# Default: <CONTENT_DIR>/recordings
RECORDINGS_DIR=./content/recordings

# PLUGINS_DIR — Parent directory for all plugin types.
# Default: <BASE_DIR>/plugins
PLUGINS_DIR=./plugins

# ENGINES_DIR — Engine plugin .py files.
# Default: <PLUGINS_DIR>/engines
ENGINES_DIR=./plugins/engines

# RESOLVERS_DIR — Resolver plugin .py files.
# Default: <PLUGINS_DIR>/resolvers
RESOLVERS_DIR=./plugins/resolvers

# NATS_SERVER_DIR — Local NATS server binary.
# Default: <BASE_DIR>/nats-server
NATS_SERVER_DIR=./nats-server

# BINARIES_DIR — Downloaded binaries (NATS, ffmpeg).
# Default: <BASE_DIR>/binaries
BINARIES_DIR=./binaries

# DB_FILE — SQLite database file path.
# Default: <BASE_DIR>/mirrorr_data.db
DB_FILE=./mirrorr_data.db


# ── HLS Streaming ─────────────────────────────────────────────────────────

# HLS_WINDOW — Sliding window duration for HLS manifest in seconds.
# Default: 7200
HLS_WINDOW=7200

# SEGMENT_DURATION — Duration of each individual HLS segment in seconds.
# Default: 10
SEGMENT_DURATION=10


# ── Scheduler ─────────────────────────────────────────────────────────────

# AUTORUN_CHECK_INTERVAL — Seconds between autorun schedule checks.
# Default: 10
AUTORUN_CHECK_INTERVAL=10


# ── API Server ────────────────────────────────────────────────────────────

# API_HOST — Address to bind the API server to.
# Default: localhost
API_HOST=localhost

# API_PORT — Port for the API server.
# Default: 8000
API_PORT=8000

# WEB_URL — Public URL for the web interface (required for production).
# Default: (empty — no web interface)
# Example: https://your-domain.duckdns.org
WEB_URL=


# ── NATS Messaging ────────────────────────────────────────────────────────

# NATS_PORT — Port for the embedded NATS server.
# Default: 4222
NATS_PORT=4222


# ── Plugin Sources ────────────────────────────────────────────────────────

# USE_SYSTEM_FFMPEG — Use ffmpeg from $PATH instead of the bundled binary.
# Default: false
USE_SYSTEM_FFMPEG=false

# USE_SYSTEM_NATS — Use nats-server from $PATH instead of the bundled binary.
# Default: false
USE_SYSTEM_NATS=false


# ── Security ──────────────────────────────────────────────────────────────

# JWT_SECRET_KEY — JWT signing key. If empty, auto-generated on first use.
# Default: (auto-generated)
# Generate a strong key for production:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=

# CORS_ALLOWED_ORIGINS — Comma-separated list of allowed CORS origins.
# Default: (empty — uses localhost defaults for development)
# Example: https://your-domain.duckdns.org,http://localhost:5173
CORS_ALLOWED_ORIGINS=

# RATE_LIMIT_LOGIN — Maximum login attempts per minute per IP.
# Default: 10
RATE_LIMIT_LOGIN=10

# RATE_LIMIT_REGISTER — Maximum registration attempts per minute per IP.
# Default: 5
RATE_LIMIT_REGISTER=5

# COOKIE_SECURE — Set the Secure flag on authentication cookies.
# Default: true
# Disable for local HTTP development: COOKIE_SECURE=false
COOKIE_SECURE=true

# COOKIE_DOMAIN — Cookie domain. Leave empty to use the request host.
# Default: (empty — uses request host)
COOKIE_DOMAIN=


# ── Development ───────────────────────────────────────────────────────────

# DEV_SERVE_FILES — Mount content_dir as static files in uvicorn.
# Default: false
DEV_SERVE_FILES=false

# DEV_RESET_DATABASE — Truncate all database tables on boot.
# Default: false
# WARNING: This deletes ALL data. Use with caution.
DEV_RESET_DATABASE=false

# DEV_SEED_ADMIN — Auto-create admin user (admin/admin) on boot.
# Default: false
# Safe to leave enabled — skips if the user already exists.
DEV_SEED_ADMIN=false
