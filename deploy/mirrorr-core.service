[Unit]
Description=Mirrorr Core API (live stream management backend)
After=network.target

[Service]
Type=simple
User=opc
Group=opc
WorkingDirectory=__REPO_ROOT__/mirrorr-core
Environment=HOME=__RUN_HOME__
Environment=BASE_DIR=__RUN_ROOT__/core
Environment=MIRRORR_ENV=production
Environment=WEB_URL=https://__SERVER_NAME__
# --dev-seed-admin only ever creates the admin user if it is missing.
ExecStart=/bin/bash __REPO_ROOT__/deploy/run-core.sh --host 127.0.0.1 --port 8000 --dev-seed-admin
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
# SIGTERM only the main process, so core can stop its supervisors in order and
# they get a chance to finalize; systemd SIGKILLs survivors after the timeout.
# The default (control-group) SIGTERMs the whole cgroup at once, killing each
# supervisor outright and leaving its session row stuck ACTIVE.
KillMode=mixed

[Install]
WantedBy=multi-user.target
