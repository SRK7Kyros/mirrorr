# Environment-specific deploy values for ONE host. Copy to
# deploy/mirrorr.local.env (gitignored) and fill in; deploy.sh sources it and
# renders the unit + nginx conf from the committed templates. Nothing here is
# ever committed, so the repo stays host-agnostic.
#
# MIRRORR_RUN_USER=mirrorr
# MIRRORR_RUN_HOME=/home/mirrorr
# MIRRORR_RUN_ROOT=/srv/mirrorr/run
# MIRRORR_PLUGINS_DIR=/srv/mirrorr/plugins
# MIRRORR_WEB_URL=https://mirrorr.example.com
# MIRRORR_SERVER_NAME=mirrorr.example.com
# MIRRORR_CERT_NAME=example.com
