[Unit]
Description=Mirrorr Web UI (Vite dev server with HMR)
After=network.target mirrorr-core.service

[Service]
Type=simple
User=opc
Group=opc
WorkingDirectory=/home/opc/everything/kyros/code/mirrorr/mirrorr-web
Environment=HOME=/home/opc
Environment=MIRRORR_BASE=/dev/
ExecStart=/bin/bash -c 'exec /home/opc/.local/share/mise/installs/bun/latest/bin/bun run dev -- --host 127.0.0.1 --port 5174'
Restart=on-failure
RestartSec=3
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
