[Unit]
Description=Mirrorr Web UI (Vite dev server with HMR)
After=network.target mirrorr-core.service

[Service]
Type=simple
User=opc
Group=opc
WorkingDirectory=__REPO_ROOT__/mirrorr-web
Environment=HOME=__RUN_HOME__
Environment=MIRRORR_BASE=/dev/
ExecStart=/bin/bash -c 'exec bun run dev -- --host 127.0.0.1 --port 5174'
Restart=on-failure
RestartSec=3
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
