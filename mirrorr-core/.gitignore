# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Dev stuff
dev_testing/
dev_scripts/

# Runtime state (base_dir defaults to CWD) — root-anchored so they never
# shadow source packages such as src/mirrorr/plugins/
/binaries/
/content/
/plugins/
/nats-server/
*.db
*.db-shm
*.db-wal

# Secrets — never commit a real .env
.env
.env.*
!.env.example