# Mirrorr web configuration. VITE_API_URL is the only variable this app reads.
#
# Contract (see src/config/env.ts):
# - Required. A missing, blank, or malformed value throws at boot, naming the
#   variable, before any request is made.
# - No trailing slash (the server runs with redirect_slashes=False).
# - Development: use "/api" — the Vite dev server proxies /api/… to the backend
#   same-origin (see vite.config.ts), so no host is baked in.
# - Production: an absolute http(s) origin, optionally with a path,
#   e.g. https://mirrorr.example.org
# - WebSocket URLs /ws/events and /ws/notifications derive from this value's
#   origin (http→ws, https→wss), never from its path.
#
# Copy to .env.local for a machine-local override (gitignored).
#
# Example production value:
# VITE_API_URL=https://mirrorr.example.org
# Example development value (also shipped as .env.development):
# VITE_API_URL=/api
VITE_API_URL=
