# Mirrorr web client — server preset / lock (Todo 5)
# SERVER_URL wins over legacy API_URL; `/` means same-origin explicitly.
# Example LAN: VITE_MIRRORR_SERVER_URL=http://192.168.1.20:8000/api
# Example prod: VITE_MIRRORR_SERVER_URL=https://mirrorr.bigbro-itzamekyros.duckdns.org/api
VITE_MIRRORR_SERVER_URL=/
# When true: hide the server-link screen + fixate API/WS on SERVER_URL above.
# Locked build goes straight to login; unlocked fresh install shows server-link.
VITE_MIRRORR_SERVER_LOCKED=false
# Legacy fallback (kept for compat — SERVER_URL wins when set):
# VITE_API_URL=/api
