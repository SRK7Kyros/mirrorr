# Mirrorr web configuration. VITE_API_URL is the only variable this app reads.
#
# Contract (see src/config/env.ts — the sole read site):
# - Required. A missing, blank, or malformed value is rejected at boot once the
#   boot-guard lands (scaffold stub currently falls back to this default).
# - No trailing slash (the server runs with redirect_slashes=False).
# - Absolute http(s) origin, optionally with a path, e.g. https://mirrorr.example.org
#   or the local core at http://127.0.0.1:8000.
# - Root-relative "/api" is the default and the recommended same-origin setup:
#   the Vite dev server proxies /api/… to http://127.0.0.1:8000/ and /ws/… to
#   the backend (see vite.config.ts). Use an absolute origin only when the API
#   is cross-origin (and the server sends CORS headers).
# - WebSocket URLs derive from this value's origin (http→ws, https→wss), never
#   from its path; a root-relative base uses window.location.host + /ws/….
#
# Copy to .env.local for a machine-local override (gitignored).
VITE_API_URL=/api
