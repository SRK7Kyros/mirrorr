{
  "name": "mirrorr-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check:tokens": "bun scripts/check-tokens.mjs",
    "check:contrast": "bun scripts/check-contrast.mjs",
    "deploy:web": "bun scripts/deploy-web.mjs",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "preview": "vite preview",
    "test": "bun run test:unit && bun run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:ratelimit": "playwright test --config playwright.ratelimit.config.ts",
    "mobile:build": "vite build && bun mobile/scripts/prepare-web-assets.mjs && bun mobile/scripts/set-native-version.mjs",
    "mobile:assets": "bun mobile/scripts/prepare-web-assets.mjs",
    "mobile:sync": "bun mobile/scripts/with-mobile-env.mjs \"bunx cap sync\"",
    "mobile:add:ios": "bun mobile/scripts/with-mobile-env.mjs \"bunx cap add ios\"",
    "mobile:add:android": "bun mobile/scripts/with-mobile-env.mjs \"bunx cap add android\"",
    "mobile:build:android:debug": "bun mobile/scripts/with-mobile-env.mjs \"bun run mobile:build && bunx cap sync android && cd mobile/android && ./gradlew assembleDebug\"",
    "mobile:build:ios:simulator": "bun mobile/scripts/with-mobile-env.mjs \"bun run mobile:build && bunx cap sync ios && cd mobile/ios/App && xcodebuild -workspace App.xcworkspace -scheme App -sdk iphonesimulator -configuration Debug build\"",
    "mobile:open:ios": "bun mobile/scripts/with-mobile-env.mjs \"bunx cap open ios\"",
    "mobile:open:android": "bun mobile/scripts/with-mobile-env.mjs \"bunx cap open android\""
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.0",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@tanstack/react-query": "5.101.0",
    "@tanstack/react-router": "1.170.16",
    "lucide-react": "^1.21.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@capacitor/cli": "^8.5.2",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "jsdom": "30.1.0",
    "tailwindcss": "4.3.1",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "vitest": "5.0.1"
  }
}
