{
  "name": "mirrorr-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "bun run test:unit && bun run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:visual": "playwright test -c playwright.visual.config.ts",
    "check:tokens": "bun scripts/check-tokens.mjs",
    "check:contrast": "bun scripts/check-contrast.mjs",
    "check:collisions": "bun scripts/check-collisions.mjs",
    "bundle:report": "bun scripts/bundle-report.mjs",
    "deploy:web": "bun scripts/deploy-web.mjs",
    "deploy:preview": "MIRRORR_PREVIEW=1 bun run deploy:web"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/preferences": "^8.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "5.101.0",
    "@tanstack/react-router": "1.170.16",
    "@videojs/core": "10.1.0",
    "@videojs/hlsjs-video": "10.1.0",
    "@videojs/react": "10.1.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "hls.js": "^1.7.3",
    "motion": "^13.4.2",
    "radix-ui": "^1.7.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tailwindcss": "^4.3.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "jsdom": "30.1.0",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "vitest": "5.0.1"
  }
}
